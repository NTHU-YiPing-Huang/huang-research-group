---
import Base from '../layouts/Base.astro';
import {content,research,type Lang} from '../data/site';
import {updates} from '../data/updates';
interface Props {lang:Lang;page:number}
const {lang,page}=Astro.props;const t=content[lang];
---
<Base lang={lang} page={page} title={t.nav[page]}><section class="inner-hero"><div class="container"><span class="section-kicker">YI-PING HUANG RESEARCH GROUP / {String(page).padStart(2,'0')}</span><h1>{t.nav[page]}</h1><p>{page===1?t.researchSub:page===4?t.newsSub:t.placeholder}</p></div></section><section class="section inner-content"><div class="container">{page===1?<div class="research-grid">{research.map(item=><article class="research-card" id={item.slug}><span class="research-icon">{item.icon}</span><h2>{item[lang].title}</h2><p>{item[lang].description}</p></article>)}</div>:page===4&&updates.length>0?<div class="news-items">{updates.map(item=><div class="news-item"><time>{item.date}</time><span>{item[lang]}</span>{item.url&&<a href={item.url}>↗</a>}</div>)}</div>:<div class="placeholder-panel"><span class="placeholder-symbol">✳</span><h2>{t.placeholder}</h2><p>{page===6?t.contactText:page===7?t.contactText:t.aboutText}</p>{page===5&&<a class="text-link" href="https://nthu-yiping-huang.github.io/CM_I_2026_Fall/" target="_blank" rel="noopener">Condensed Matter Physics I ↗</a>}</div>}</div></section></Base>
