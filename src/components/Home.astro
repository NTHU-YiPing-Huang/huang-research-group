---
import Base from '../layouts/Base.astro';
import {content,type Lang} from '../data/site';
import {updates} from '../data/updates';
import {getCollection, render} from 'astro:content';
interface Props {lang:Lang}
const researchEntries=(await getCollection('research', ({data})=>data.lang===Astro.props.lang)).sort((a,b)=>a.data.order-b.data.order);
const highlightEntries=(await getCollection('highlights', ({data})=>data.lang===Astro.props.lang)).sort((a,b)=>a.data.order-b.data.order);
const research=await Promise.all(researchEntries.map(async entry=>({entry, Content:(await render(entry)).Content})));
const highlights=await Promise.all(highlightEntries.map(async entry=>({entry, Content:(await render(entry)).Content})));
const {lang}=Astro.props;const t=content[lang];const base=import.meta.env.BASE_URL.replace(/\/$/,'');const link=(p:string)=>`${base}/${lang}/${p}`;
---
<Base lang={lang} page={0}>

<!-- Homepage Hero: Split Tone Banner -->
<section class="hero hero-split">
  <div class="hero-split-layout">

    <!-- Left: Text content -->
    <div class="hero-split-left">
      <div class="hero-copy">

        <div class="eyebrow">
          <span class="pulse"></span>
          {t.eyebrow}
        </div>

        <h1>{t.headline}</h1>

        <p class="lead">
          {t.intro}
        </p>

        <div class="hero-actions">
          <a
            class="btn btn-primary"
            href={link('research/')}
          >
            {t.explore}
            <span aria-hidden="true">↗</span>
          </a>

          <a
            class="btn btn-outline"
            href={link('join/')}
          >
            {t.join}
            <span aria-hidden="true">→</span>
          </a>
        </div>

      </div>
    </div>

    <!-- Right: SVG Logo -->
    <div class="hero-split-right">
      <div class="hero-logo-container">
        <img
          class="hero-logo"
          src={`${base}/logo-wide.svg`}
          alt="Yi-Ping Huang Research Group"
          width="548"
          height="200"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>

  </div>
</section>
<section class="section about"><div class="container about-grid"><div><span class="section-kicker">OUR PERSPECTIVE / 研究理念</span><h2>{t.aboutTitle}</h2></div><p>{t.aboutText}</p></div></section>
<section class="section research-section"><div class="container"><div class="section-head"><div><span class="section-kicker">01 / RESEARCH</span><h2>{t.researchTitle}</h2><p>{t.researchSub}</p></div><a class="text-link" href={link('research/')}>{t.readMore} ↗</a></div><div class="research-grid">{research.map((item,i)=><a class="research-card" href={link('research/')+'#'+item.entry.data.slug}><div class="research-card-top"><span class="research-icon">{item.entry.data.icon}</span><span class="card-index">0{i+1}</span></div><h3>{item.entry.data.title}</h3><div class="markdown-content"><item.Content /></div><span class="card-arrow">↗</span></a>)}</div></div></section>
<section class="section highlights-section"><div class="container"><div class="section-head"><div><span class="section-kicker">02 / HIGHLIGHTS</span><h2>{t.highlightsTitle}</h2><p>{t.highlightsSub}</p></div><a class="text-link" href={link('publications/')}>{t.nav[2]} ↗</a></div><div class="highlight-list">{highlights.map((item)=><article class="highlight-item"><div class="highlight-visual"><span class="visual-number">{String(item.entry.data.order).padStart(2,'0')}</span><div class="visual-rings"><i></i><i></i><i></i></div></div><div class="highlight-content"><span class="tag">{item.entry.data.tag}</span><h3>{item.entry.data.title}</h3><div class="markdown-content"><item.Content /></div></div><span class="highlight-arrow">↗</span></article>)}</div></div></section>
<section class="section news-section"><div class="container"><div class="section-head"><div><span class="section-kicker">03 / NEWS</span><h2>{t.newsTitle}</h2><p>{t.newsSub}</p></div><a class="text-link" href={link('news/')}>{t.readMore} ↗</a></div>{updates.length===0?<p class="empty-news">{t.newsEmpty}</p>:<div class="news-items">{updates.slice(0,3).map(item=><div class="news-item"><time>{item.date}</time><span>{item[lang]}</span>{item.url&&<a href={item.url} target="_blank" rel="noopener">↗</a>}</div>)}</div>}</div></section>
<section class="contact-band"><div class="container contact-band-inner"><div><span class="section-kicker">LET'S CONNECT</span><h2>{t.contactTitle}</h2><p>{t.contactText}</p></div><a class="btn btn-primary" href={link('contact/')}>{t.contactButton} ↗</a></div></section>
</Base>
