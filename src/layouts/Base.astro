---
import '../styles/global.css';
import '../styles/refinements.css';
import 'katex/dist/katex.min.css';
import '../styles/math.css';
import '../styles/theme-teal-orange.css';
import { content, paths, type Lang } from '../data/site';
interface Props { lang:Lang; page:number; title?:string; }
const {lang,page,title} = Astro.props;
const t=content[lang];
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const url=(language:Lang,idx:number)=>`${base}/${language}/${paths[idx] ? paths[idx]+'/' : ''}`;
const other=lang==='en'?'zh':'en';
const fullTitle=title ? `${title} | Yi-Ping Huang Research Group` : 'Yi-Ping Huang Research Group';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#0b1424"/><meta name="description" content={t.intro}/>
<title>{fullTitle}</title>
<link rel="alternate" hreflang="en" href={new URL(url('en',page), Astro.site)}/>
<link rel="alternate" hreflang="zh-Hant" href={new URL(url('zh',page), Astro.site)}/>
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}/>
</head>
<body>
<header class="site-header"><div class="container header-inner">
<a class="brand" href={url(lang,0)} aria-label="Homepage"><span class="brand-mark">Y<span class="brand-dot">.</span>H</span><span class="brand-label"><strong>YI-PING HUANG</strong><small>QUANTUM MANY-BODY THEORY</small></span></a>
<nav class="desktop-nav" aria-label="Main navigation">{t.nav.map((name,i)=><a class:list={{active:page===i}} href={url(lang,i)}>{name}</a>)}</nav>
<div class="header-actions"><div class="lang-toggle" aria-label="Language"><a class:list={{selected:lang==='en'}} href={url('en',page)}>EN</a><span>/</span><a class:list={{selected:lang==='zh'}} href={url('zh',page)}>中</a></div><button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav">☰</button></div>
</div><nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>{t.nav.map((name,i)=><a href={url(lang,i)}>{name}</a>)}</nav></header>
<main><slot/></main>
<footer class="site-footer"><div class="container footer-inner"><span>{t.footer}</span><span>© {new Date().getFullYear()} · <a href="https://github.com/" target="_blank" rel="noopener">GitHub Pages</a></span></div></footer>
<script>const button=document.querySelector<HTMLButtonElement>('.menu-toggle');const menu=document.querySelector<HTMLElement>('#mobile-nav');button?.addEventListener('click',()=>{const expanded=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!expanded));if(menu)menu.hidden=expanded;});</script>
</body></html>
